# Copy to .env and replace every ChangeMe value.
# The server refuses to start while a secret still contains change-me.

NODE_ENV=production
HOST=127.0.0.1
PORT=8090
PUBLIC_URL=http://127.0.0.1:8090
TRUST_PROXY=false
COOKIE_SECURE=false

DATABASE_URL=pglite:./data/pg
POSTGRES_PASSWORD=ChangeMe
DATA_DIR=./data
PG_POOL_MAX=10

SESSION_SECRET=change-me-session-secret-at-least-32-chars
SESSION_TTL_HOURS=168
SCRYPT_N=65536

# ADMIN_EMAIL is the security.txt contact and the first admin's address, not the login name.
ADMIN_EMAIL=SomeUser@hzmods.lol
ADMIN_USERNAME=someuser
ADMIN_PASSWORD=ChangeMe

# Login and registration: a name, a password, and Cloudflare Turnstile.
TURNSTILE_SITE_KEY=1x0
TURNSTILE_SECRET_KEY=1x0

MAX_UPLOAD_BYTES=67108864
GAME_VERSIONS=26.3
HORIZON_MOD_CHECK_BIN=
HORIZON_MOD_CHECK_REQUIRED=false
HORIZON_MOD_CHECK_TIMEOUT_MS=30000
TRUSTED_OWNER_UPDATES=false

# Optional ping to a companion bot. Leave both empty to let that bot poll /api/v1/feed.
# BOT_NOTIFY_URL=http://127.0.0.1:8091/notify
# BOT_NOTIFY_SECRET=
USER_QUOTA_BYTES=536870912

RATE_IP_PER_MIN=300
RATE_ANON_READ_PER_MIN=60
RATE_USER_READ_PER_MIN=180
RATE_KEY_READ_PER_MIN=600
RATE_USER_WRITE_PER_MIN=60
RATE_KEY_WRITE_PER_MIN=60
RATE_LOGIN_PER_15MIN=10
RATE_REGISTER_PER_HOUR=5
RATE_UPLOAD_PER_HOUR=20
RATE_DOWNLOAD_ANON_PER_MIN=120
RATE_DOWNLOAD_USER_PER_MIN=600
