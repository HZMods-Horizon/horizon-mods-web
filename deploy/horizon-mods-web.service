[Unit]
Description=Horizon Mods unofficial registry
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/horizon-mods-web
EnvironmentFile=/opt/horizon-mods-web/.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=3
User=horizon
Group=horizon
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
